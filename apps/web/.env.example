# Copy to .env.local and adjust. Every value here is public — NEXT_PUBLIC_* is
# inlined into the browser bundle, so no secret ever belongs in this file.

# Base URL of the .NET API, including the /api suffix.
# Local:      http://localhost:5000/api
# Production: https://api.seudominio.com.br/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public origin of the web app itself, without a trailing slash. Used for
# canonical/Open Graph URLs, sitemap.xml and robots.txt. Leaving it unset falls
# back to http://localhost:3000, which is fine locally and wrong in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
