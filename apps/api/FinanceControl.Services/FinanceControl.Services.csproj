<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Anthropic" Version="12.45.0" />
      <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
      <PackageReference Include="FluentValidation" Version="12.1.1" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FinanceControl.Data\FinanceControl.Data.csproj" />
      <ProjectReference Include="..\FinanceControl.Domain\FinanceControl.Domain.csproj" />
      <ProjectReference Include="..\FinanceControl.Shared\FinanceControl.Shared.csproj" />
    </ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- Legal texts ship inside the assembly rather than as loose files: the seeder can
	     then read them the same way in a container, in a test host and on a dev machine,
	     with no path to get wrong. -->
	<ItemGroup>
		<EmbeddedResource Include="Legal\Content\*.md" />
	</ItemGroup>

</Project>
