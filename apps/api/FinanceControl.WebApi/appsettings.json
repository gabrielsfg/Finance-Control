{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "BrapiSettings": {
    "Token": "",
    "BatchSize": 20,
    "MaxParallelBatches": 2,
    "TimeoutSeconds": 30,
    "RetryDelayMinutes": 3,
    "TargetHourUtc": 22,
    "BackfillRange": "max"
  }
}
