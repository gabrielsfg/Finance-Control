{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "AnthropicSettings": {
    "ApiKey": "",
    "Enabled": false,
    "AnalysisModel": "claude-sonnet-5",
    "MaxOutputTokens": 2000,
    "TimeoutSeconds": 60,
    "MonthlySpendingInsightsPerUser": 6,
    "MonthlyPortfolioInsightsPerUser": 4,
    "MaxPriceAgeDays": 7
  },
  "AdminSettings": {
    "AllowedUserIds": []
  },
  "BrapiSettings": {
    "Token": "",
    "BatchSize": 20,
    "MaxParallelBatches": 2,
    "TimeoutSeconds": 30,
    "RetryDelayMinutes": 3,
    "TargetHourUtc": 22,
    "BackfillRange": "max"
  }
}
