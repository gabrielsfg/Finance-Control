  "BrapiSettings": {
    "Token": "",
    "BatchSize": 20,
    "MaxParallelBatches": 2,
    "TimeoutSeconds": 30,
    "RetryDelayMinutes": 3,
    "TargetHourUtc": 22,
    "BackfillRange": "max"
  }
