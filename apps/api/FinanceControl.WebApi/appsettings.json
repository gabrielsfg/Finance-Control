{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "AnthropicSettings": {
    "ApiKey": "",
    "Enabled": false,
    "AnalysisModel": "claude-sonnet-5",
    "ChatModel": "claude-sonnet-5",
    "ImportModel": "claude-haiku-4-5",
    "MaxOutputTokens": 2000,
    "ChatMaxOutputTokens": 1500,
