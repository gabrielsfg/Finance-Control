<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ masks the icon to the launcher's own shape (circle, squircle…), so the
     cobalt tile is the background and only the Quantia glyph is the foreground. The
     monochrome layer is what Android 13+ tints for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
